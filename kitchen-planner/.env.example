# Copy this file to .env.local and paste your own key. .env.local is git-ignored and must never be committed.
ANTHROPIC_API_KEY=
# Supabase (accounts and saved data). Both values are safe for the browser by design.
# Find them in the Supabase dashboard: Connect button, or Settings > API Keys.
# NEVER put the secret key (sb_secret_...) here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: choose a different Claude model (default is a fast, low-cost one)
# ANTHROPIC_MODEL=claude-haiku-5-5
